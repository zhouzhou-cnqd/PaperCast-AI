# 复制为 .env 并填写；.env 已被 gitignore，切勿提交真实密钥
# DeepSeek（实验 B 脚本生成 / 实验 E 导师回答，按量计费）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qdrant Cloud（互动问答的多语言向量 + BM25 混合检索）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=papercast_evidence
QDRANT_PROXY=

# HuggingFace 镜像（国内网络可选，用于下载 Docling/Qwen3-TTS 权重）
# HF_ENDPOINT=https://hf-mirror.com

# TTS 提供方选择：qwen3_tts | cosyvoice | none
TTS_PROVIDER=qwen3_tts
